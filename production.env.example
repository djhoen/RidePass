# RidePass production environment template
#
# This is a COMMITTED, secret-free checklist of the configuration RidePass needs
# in production. The REAL file lives on the droplet at /etc/ridepass/production.env
# (root-owned, chmod 600, NOT in git). scripts/deploy.sh and .github/workflows/deploy.yml
# `set -a; source /etc/ridepass/production.env; set +a` before running the migrator
# and (re)starting the API under pm2, so every line below becomes a process env var.
#
# .NET maps double-underscore env vars onto colon config keys: Foo__Bar => "Foo:Bar".
# Use the Foo__Bar form here (that is what the shell exports); do NOT use colons.
#
# To use: copy this file to /etc/ridepass/production.env on the droplet and replace
# every _REPLACE_ME placeholder with the real value. Keep the real file out of git.

# =============================================================================
# REQUIRED  -  the app throws at startup (or silently fails to take payments /
# route tenants) if any of these are missing. Deploys will not come up healthy.
# =============================================================================

# Postgres connection string. Used by BOTH the migrator and the API; each throws
# at startup if it is unset. Get it from the DigitalOcean managed-database
# "Connection details" panel (include sslmode=require).
ConnectionStrings__Default=Host=db.example.com;Port=25060;Database=ridepass;Username=ridepass;Password=REPLACE_ME;SSL Mode=Require;Trust Server Certificate=true

# JWT issuer/audience string. Any stable identifier for this deployment
# (e.g. the apex host). The API throws "Jwt:Issuer is not configured." if unset.
Jwt__Issuer=https://ridepass.io

# Secret used to sign and validate JWTs (HMAC-SHA256). Must be a long, random,
# private string; rotating it invalidates every issued token. Generate with
# `openssl rand -base64 48`. The API throws "Jwt:SigningKey is not configured." if unset.
Jwt__SigningKey=REPLACE_ME_LONG_RANDOM_SECRET

# At-rest AES key + IV (base64) for encrypting sensitive blobs such as per-tenant
# Twilio auth tokens. The API throws at startup if either is missing.
# Key = 32 bytes base64: `openssl rand -base64 32`
# IV  = 16 bytes base64: `openssl rand -base64 16`
# WARNING: rotating these makes already-stored encrypted tokens undecryptable.
Encryption__KeyBase64=REPLACE_ME_BASE64_32_BYTES
Encryption__IvBase64=REPLACE_ME_BASE64_16_BYTES

# Apex domain used by TenantResolutionMiddleware to strip the subdomain and
# resolve the tenant (e.g. demo.ridepass.io -> tenant "demo"). The API throws
# "Tenant:RootDomain is not configured." if unset, so tenant routing is dead without it.
Tenant__RootDomain=ridepass.io

# Stripe live secret key. Server-side key for charges, transfers, refunds, and
# Connect. Every payment method throws "Stripe:SecretKey is not configured." if
# empty, so no money moves. Stripe Dashboard -> Developers -> API keys (live mode).
Stripe__SecretKey=sk_live_REPLACE_ME

# Stripe live publishable key. Served to the browser via the tenant branding
# response; Stripe.js card entry cannot initialize without it (the buy flows show
# "Stripe publishable key is not configured"). Same Dashboard -> API keys page.
Stripe__PublishableKey=pk_live_REPLACE_ME

# Stripe webhook signing secret. Incoming webhooks are rejected when this is
# empty (payment finalization then relies only on the catch-up reconciler).
# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
Stripe__WebhookSecret=whsec_REPLACE_ME

# Signing secret for the SEPARATE Connect webhook endpoint (/api/Payment/ConnectWebhook),
# which carries events for direct-charge tenants (charges on their own connected
# account). Distinct from Stripe__WebhookSecret above — Stripe signs Connect
# endpoints with their own secret. Leave unset only if no tenant uses
# stripe_charge_mode='direct'; their payments then never finalize from webhooks.
# Stripe Dashboard -> Developers -> Webhooks -> your Connect endpoint -> Signing secret.
Stripe__ConnectWebhookSecret=whsec_REPLACE_ME

# =============================================================================
# OPTIONAL  -  features degrade gracefully when these are unset. Each note below
# states the exact consequence of leaving it out.
# =============================================================================

# --- Transactional email (SMTP) ---------------------------------------------
# Email is gated on BOTH Email__Smtp__Host and Email__FromAddress being set. If
# either is missing, SmtpEmailer.IsConfigured is false and Send() is a silent
# no-op: unset = NO rider receipt / QR-code / password-reset emails are sent.
#Email__Smtp__Host=smtp.example.com
#Email__Smtp__Port=587                         # defaults to 587 if unset
#Email__Smtp__User=apikey                      # omit for unauthenticated relays
#Email__Smtp__Password=REPLACE_ME
#Email__FromAddress=noreply@ridepass.io
#Email__FromName=RidePass                      # defaults to "RidePass" if unset

# For Amazon SES the SMTP settings above are the SES SMTP endpoint + credentials:
#   Email__Smtp__Host=email-smtp.us-east-1.amazonaws.com   (your SES region)
#   Email__Smtp__User / Password = the SES SMTP credentials (NOT your AWS keys)

# --- SES bounce/complaint webhook (SNS) -------------------------------------
# Feeds SES bounce/complaint events into the suppression list at POST /api/SesWebhook.
# Ships dark: the route returns 404 until WebhookEnabled is "true". Point an SNS topic
# (subscribed to the SES configuration set's bounce + complaint events) at that URL.
#Email__Ses__WebhookEnabled=true
#Email__Ses__VerifySignature=true              # only "false" disables SNS signature checks (local testing)

# Optional: separate signing key for one-click unsubscribe links. Falls back to
# Jwt__SigningKey when unset, so it's not required.
#Email__UnsubscribeSigningKey=REPLACE_ME_LONG_RANDOM_SECRET

# --- Twilio SMS global fallback ---------------------------------------------
# Legacy/global fallback used only by tenants that have NOT provisioned their own
# Twilio subaccount in Settings -> SMS. All three must be set for the fallback to
# be active. Unset = tenants without per-tenant Twilio credentials send no SMS
# (notifications/waitlist texts are silently skipped for them).
#Sms__Twilio__AccountSid=AC_REPLACE_ME
#Sms__Twilio__AuthToken=REPLACE_ME
#Sms__Twilio__FromNumber=+15555550123

# Twilio status-callback URL for outbound messages. Unset = Twilio sends no
# delivery-status callbacks, so no SMS billing-ledger rows are created.
#Sms__Twilio__StatusCallbackUrl=https://ridepass.io/api/webhooks/twilio/status

# --- LoamPassMx integration -------------------------------------------------
# Calls the LoamMx (loampassmx.com) partner API so riders can link their Loam Pass
# and redeem credits for entry at LoamPassMx tracks. Both must be set for the
# integration to be active; the ApiKey must match RidePassIntegration:ApiKey on
# the LoamMx side. Unset = the feature is inert (no link/redeem calls are made).
#LoamPassMx__BaseUrl=https://loampassmx.com/api
#LoamPassMx__ApiKey=REPLACE_ME_SHARED_SECRET

# --- Misc tunables ----------------------------------------------------------
# Apex domain for building absolute links in emails/notifications. Unset =
# falls back to the hard-coded default "ridepass.io".
#App__RootDomain=ridepass.io

# Dollar (cent) threshold above which a sale fires the "large_sale" admin
# notification. Unset = defaults to 50000 ($500).
#Notifications__LargeSaleThresholdCents=50000

# Cents charged back to a tenant ledger when Stripe assesses a dispute fee.
# Unset = defaults to 1500 ($15, Stripe's standard fee).
#Stripe__DisputeFeeCents=1500

# Honor the X-Tenant-Subdomain header from native API clients (e.g. the cashier
# mobile app) that have no subdomain to resolve from. Unset/false = header is
# ignored. Safe to enable: the JWT tenant_id claim is still cross-checked.
#Tenant__AllowApiClientTenantHeader=false

# --- Image storage: DigitalOcean Spaces (S3) --------------------------------
# When Storage__Spaces__Bucket is set, image uploads go to the Spaces bucket and stored
# URLs are absolute (so staging can render them without copying files). Unset = local
# disk under wwwroot/uploads (the legacy behavior the deploy preserves across deploys).
# After setting these, run the one-time migration: sync wwwroot/uploads to the bucket,
# then scripts/rewrite-upload-urls.sql to repoint existing DB URLs.
#Storage__Spaces__ServiceUrl=https://sfo3.digitaloceanspaces.com
#Storage__Spaces__Bucket=ridepass-uploads
#Storage__Spaces__AccessKey=REPLACE_ME
#Storage__Spaces__SecretKey=REPLACE_ME
# Optional: serve via CDN instead of the origin (recommended). No trailing slash.
#Storage__Spaces__PublicBaseUrl=https://ridepass-uploads.sfo3.cdn.digitaloceanspaces.com

# --- Stage -> prod tenant promotion (super-admin) ---------------------------
# Lets prod pull a configured, unpublished tenant up from staging. The same shared
# Key must be set in BOTH staging.env and production.env. Stage validates inbound
# sync calls against Key + AllowedIps; prod uses Key + SourceBaseUrl to call stage.
# Unset Key = the sync surface is dark (404) in that environment.
#   On PROD:
#TenantSync__Key=REPLACE_ME_LONG_RANDOM_SHARED_SECRET
#TenantSync__SourceBaseUrl=https://stage.ridepass.io
#   On STAGE (lock the export endpoints to the prod droplet):
#TenantSync__Key=REPLACE_ME_LONG_RANDOM_SHARED_SECRET   # same value as prod
#TenantSync__AllowedIps=146.190.48.200                  # the prod droplet IP

# -----------------------------------------------------------------------------
# QuickBooks Online sync (Admin -> Settings -> QuickBooks)
# Unset: the QuickBooks panel reports "not set up", no tenant can connect, and
# the TaskRunner sync loop logs once and disables itself. Nothing else changes.
#
# Create an app at https://developer.intuit.com -> My Apps -> your app -> Keys.
# The redirect URI must match EXACTLY one registered on the Intuit app (no
# wildcards). It points at the APEX host, not a tenant subdomain: Intuit allows
# only fixed redirect URIs, so the callback carries the tenant in its `state`
# and then bounces back to the tenant's own settings page.
#QuickBooks__ClientId=REPLACE_ME
#QuickBooks__ClientSecret=REPLACE_ME
#QuickBooks__RedirectUri=https://ridepass.io/api/QuickBooks/Callback
# "sandbox" (default) or "production". Picks the API host. A sandbox app can
# only talk to sandbox companies, so this must be flipped for real books.
#QuickBooks__Environment=production
