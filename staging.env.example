# RidePass STAGING environment template
#
# Committed, secret-free checklist for the staging deployment. The REAL file lives
# on the staging droplet at /etc/ridepass/staging.env (root-owned, chmod 600, NOT
# in git). deploy-stage-action.yml sources it before the migrator and pm2 restart.
#
# Same conventions as production.env.example: Foo__Bar => "Foo:Bar", _REPLACE_ME = fill in.
#
# The whole point of staging is that it can NEVER touch real money, phones, or inboxes:
#   - Stripe TEST keys only (sk_test_ / pk_test_).
#   - Twilio left unset (no SMS).
#   - Email left unset or pointed at a catch-all (Mailtrap), never a real relay.
# scripts/sanitize-stage.sql already nulls cloned Stripe/Twilio identifiers, but the
# keys below are the real guardrail.

# =============================================================================
# REQUIRED
# =============================================================================

# Staging database. A SEPARATE database (e.g. ridepass_stage) on the SAME managed
# cluster as prod is free; create it + a ridepass_stage_app user in the DO console.
# Do NOT point this at the prod `ridepass` database.
# MUST be double-quoted: the deploy does `set -a; source staging.env`, and the value
# contains spaces ("SSL Mode") and ';' separators that bash would otherwise treat as
# shell syntax. Use the cluster's PRIVATE host (the droplet is on the DB's VPC).
ConnectionStrings__Default="Host=private-ridepass-db-do-user-XXXX.k.db.ondigitalocean.com;Port=25060;Database=ridepass_stage;Username=ridepass_stage_app;Password=REPLACE_ME;SSL Mode=Require;Trust Server Certificate=true"

# Stage issuer (any stable identifier for this deployment).
Jwt__Issuer=https://stage.ridepass.io

# Generate fresh, stage-only secrets (do NOT reuse the production values):
#   openssl rand -base64 48
Jwt__SigningKey=REPLACE_ME_LONG_RANDOM_SECRET

# Idle timeout for normal (non-"remember me") sessions, in minutes. Sessions slide:
# activity re-issues the token, so this only logs out users idle this long. Optional;
# defaults to 30 from appsettings.json.
#Jwt__IdleTimeoutMinutes=30

# Stage-only at-rest keys. They can differ from prod because sanitize-stage.sql nulls
# the cloned encrypted Twilio tokens, so there is nothing prod-encrypted to decrypt.
#   Key = openssl rand -base64 32   ;   IV = openssl rand -base64 16
Encryption__KeyBase64=REPLACE_ME_BASE64_32_BYTES
Encryption__IvBase64=REPLACE_ME_BASE64_16_BYTES

# Drives tenant resolution: demo.stage.ridepass.io -> tenant "demo". MUST be the
# staging apex (this is what makes the whole stage subdomain scheme work).
Tenant__RootDomain=stage.ridepass.io

# Stripe TEST keys only. Stripe Dashboard -> toggle "Test mode" -> Developers -> API keys.
Stripe__SecretKey=sk_test_REPLACE_ME
Stripe__PublishableKey=pk_test_REPLACE_ME
# Webhook secret for the STAGING endpoint (a separate test-mode webhook pointing at
# https://stage.ridepass.io/api/<stripe webhook route>).
Stripe__WebhookSecret=whsec_REPLACE_ME

# =============================================================================
# OPTIONAL (keep these OFF/sandboxed on staging)
# =============================================================================

# Absolute-link apex for emails/notifications.
#App__RootDomain=stage.ridepass.io

# --- Email: leave unset so Send() is a silent no-op, OR point at a catch-all inbox
#     like Mailtrap so you can inspect mail without delivering to real people.
#     NEVER set a real sending relay on staging.
#Email__Smtp__Host=sandbox.smtp.mailtrap.io
#Email__Smtp__Port=587
#Email__Smtp__User=REPLACE_ME
#Email__Smtp__Password=REPLACE_ME
#Email__FromAddress=noreply@stage.ridepass.io
#Email__FromName=RidePass (staging)

# --- Twilio: leave unset on staging (no SMS is sent).
#Sms__Twilio__AccountSid=
#Sms__Twilio__AuthToken=
#Sms__Twilio__FromNumber=

# --- LoamPassMx: leave unset, or point at a LoamMx staging API if one exists.
#LoamPassMx__BaseUrl=
#LoamPassMx__ApiKey=

# Honor X-Tenant-Subdomain header (mobile cashier app). Off unless you test the app
# against staging.
#Tenant__AllowApiClientTenantHeader=false

# --- Staging data mirror (super-admin "Refresh staging from production") ----------
# Powers the in-app button that copies prod down to staging. ONLY honored when
# ASPNETCORE_ENVIRONMENT=Staging (the code path is inert on production), but as a
# safety rule do NOT set any StageMirror__* on the production box.
StageMirror__Enabled=true
# Read-only production connection as a libpq URI (pg_dump reads from here). Use a
# SELECT-only user. Private host since the droplet shares the DB VPC.
StageMirror__SourceUrl=postgresql://ridepass_readonly:REPLACE_ME@private-ridepass-db-do-user-14792279-0.k.db.ondigitalocean.com:25060/ridepass?sslmode=require
# The STAGING database as a libpq URI (restore target). MUST contain "stage".
StageMirror__TargetUrl=postgresql://ridepass_stage_app:REPLACE_ME@private-ridepass-db-do-user-14792279-0.k.db.ondigitalocean.com:25060/ridepass_stage?sslmode=require
# Optional override; defaults to /var/www/staging/scripts/refresh-stage-db.sh
#StageMirror__ScriptPath=/var/www/staging/scripts/refresh-stage-db.sh

# --- Image storage: DigitalOcean Spaces (S3) -------------------------------------
# When Storage__Spaces__Bucket is set, uploads go to Spaces and image URLs are absolute
# bucket URLs; unset = local disk (dev). New STAGE uploads should write to a SEPARATE
# stage bucket so they can't touch prod's objects. Cloned prod image URLs still resolve
# because they point at prod's public bucket directly.
Storage__Spaces__ServiceUrl=https://sfo3.digitaloceanspaces.com
Storage__Spaces__Bucket=ridepass-uploads-stage
Storage__Spaces__AccessKey=REPLACE_ME
Storage__Spaces__SecretKey=REPLACE_ME
# Optional: serve via CDN instead of the origin (recommended). No trailing slash.
#Storage__Spaces__PublicBaseUrl=https://ridepass-uploads-stage.sfo3.cdn.digitaloceanspaces.com
