# RidePass nginx config, tenant-subdomain wildcard routing.
# Copy to /etc/nginx/sites-available/ridepass, symlink to sites-enabled, reload.
# Assumes wildcard cert at /etc/letsencrypt/live/ridepass.io/{fullchain,privkey}.pem

# Apex + all tenant subdomains: HTTP -> HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ridepass.io *.ridepass.io;

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    location / { return 301 https://$host$request_uri; }
}

# HTTPS: serve everything
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ridepass.io *.ridepass.io;

    ssl_certificate     /etc/letsencrypt/live/ridepass.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ridepass.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 25M;

    # .NET webapi (controllers + uploaded static files like tenant logos)
    location ~ ^/(api|uploads)/ {
        proxy_pass http://127.0.0.1:7293;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 90s;
    }

    # Vue static server (server.js on :8080)
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
